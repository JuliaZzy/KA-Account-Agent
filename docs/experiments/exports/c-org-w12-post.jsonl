t_cny": 0.0034884, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 792, "prompt_tokens": 5617, "completion_tokens": 22, "cache_hit_tokens": 1920, "cost_cny": 0.0038234000000000002, "usage_source": "actual"}]}, "executed_sql": ["WITH active_contract AS (SELECT id FROM contracts WHERE status = 'active' ORDER BY created_at DESC LIMIT 1) SELECT cc.number, cc.title AS chunk_title, cc.path, cc.body FROM active_contract AS ac JOIN contract_chunks AS cc ON cc.contract_id = ac.id WHERE cc.body ILIKE '%目标%' OR cc.body ILIKE '%未达成%' OR cc.body ILIKE '%取消%' OR cc.body ILIKE '%独家权%' OR cc.body ILIKE '%终止%' OR cc.title ILIKE '%目标%' OR cc.title ILIKE '%终止%' OR cc.title ILIKE '%独家%' OR cc.title ILIKE '%销售%' ORDER BY cc.sibling_order"], "plan": [{"id": "1", "agent": "data", "depends_on": []}], "po_count_before": 1349, "po_count_after": 1349, "order_created": false}

h", "status": "succeeded", "latency_ms": 571, "prompt_tokens": 3691, "completion_tokens": 22, "cache_hit_tokens": 3456, "cost_cny": 0.00039212, "usage_source": "actual"}]}, "executed_sql": ["SELECT p.category AS category_name, SUM(poi.line_total) AS total_amount FROM purchase_orders AS po JOIN purchase_order_items AS poi ON poi.po_id = po.id JOIN products AS p ON p.id = poi.product_id WHERE po.submitted_at >= '2026-09-01' AND po.submitted_at < '2026-10-01' GROUP BY p.category ORDER BY total_amount DESC LIMIT 100", "SELECT TO_CHAR(submitted_at, 'YYYY-MM') AS month, SUM(total_amount) AS total_amount, SUM(qty) AS total_boxes, COUNT(DISTINCT po.id) AS order_count FROM purchase_orders AS po LEFT JOIN (SELECT po_id, SUM(quantity) AS qty FROM purchase_order_items GROUP BY po_id) AS i ON i.po_id = po.id WHERE submitted_at >= '2026-04-01' AND submitted_at < '2026-10-01' GROUP BY 1 ORDER BY 1 LIMIT 100", "SELECT p.sku, p.product_name_en, SUM(f.numeric_value) AS units_sold, COUNT(*) AS fact_count FROM report_facts AS f JOIN sales_reports AS sr ON sr.id = f.report_id LEFT JOIN products AS p ON p.id = f.product_id WHERE f.status = 'confirmed' AND sr.status = 'confirmed' AND f.metric_key = 'units_sold' AND f.period_start >= '2026-09-01' AND f.period_end <= '2026-09-30' GROUP BY p.sku, p.product_name_en ORDER BY units_sold DESC LIMIT 100", "WITH po AS (SELECT id FROM purchase_orders WHERE submitted_at >= '2026-09-01' AND submitted_at < '2026-10-01') SELECT p.category, SUM(i.line_total) AS amount, SUM(i.quantity) AS cases, SUM(i.line_total) * 100.0 / SUM(SUM(i.line_total)) OVER () AS amount_share_pct, COUNT(*) AS line_count FROM purchase_order_items AS i JOIN po ON po.id = i.po_id LEFT JOIN products AS p ON p.id = i.product_id GROUP BY p.category ORDER BY amount DESC LIMIT 100", "WITH inv AS (SELECT rf.sku, rf.product_id, SUM(rf.numeric_value) AS stock_on_hand, COUNT(*) AS fact_count FROM report_facts AS rf JOIN sales_reports AS sr ON sr.id = rf.report_id WHERE sr.status = 'confirmed' AND rf.status = 'confirmed' AND rf.metric_key = 'stock_on_hand' AND rf.period_start >= '2026-09-01' AND rf.period_end <= '2026-09-30' GROUP BY rf.sku, rf.product_id) SELECT inv.sku, COALESCE(p.product_name_en, p.product_name_native) AS product_name, inv.stock_on_hand, inv.fact_count FROM inv LEFT JOIN products AS p ON p.id = inv.product_id ORDER BY inv.sku LIMIT 100", "SELECT po_number, status, total_amount, eta_date FROM purchase_orders WHERE status <> 'completed' AND (submitted_at IS NULL OR submitted_at < '2026-10-01') ORDER BY po_number LIMIT 100", "SELECT poi.product_name, poi.sku, SUM(poi.quantity) AS total_quantity, SUM(poi.line_total) AS total_amount FROM purchase_orders AS po JOIN purchase_order_items AS poi ON poi.po_id = po.id WHERE po.submitted_at >= '2026-09-01' AND po.submitted_at < '2026-10-01' GROUP BY poi.product_name, poi.sku ORDER BY poi.product_name, poi.sku LIMIT 100"], "plan": [{"id": "task_report_draft", "agent": "report", "depends_on": []}, {"id": "task_chart_data", "agent": "data", "depends_on": []}], "charts": [{"legend": {"bottom": "0", "textStyle": {"color": "#666"}}, "series": [{"data": [{"name": "Chocolate", "value": 10396.35, "itemStyle": {"color": "#4A6FA5"}}, {"name": "Biscuits & Cakes", "value": 8161.8, "itemStyle": {"color": "#9067A3"}}, {"name": "Grocery", "value": 1534.68, "itemStyle": {"color": "#48A18C"}}], "type": "pie", "label": {"show": true, "color": "#666", "formatter": "{b}\n{d}%"}, "center": ["50%", "45%"], "radius": ["40%", "65%"], "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "avoidLabelOverlap": true}], "tooltip": {"trigger": "item", "formatter": "{b}: {c} ({d}%)"}}, {"color": ["#4A6FA5", "#9067A3", "#48A18C"], "legend": {"bottom": "0", "textStyle": {"color": "#666"}}, "series": [{"data": [{"name": "Chocolate", "value": 10396.35}, {"name": "Biscuits & Cakes", "value": 8161.8}, {"name": "Grocery", "value": 1534.68}], "type": "pie", "label": {"show": true, "color": "#666", "formatter": "{b}\n{d}%"}, "cente
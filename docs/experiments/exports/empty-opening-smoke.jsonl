ct_id GROUP BY p.category ORDER BY amount DESC LIMIT 100", "SELECT TO_CHAR(submitted_at, 'YYYY-MM') AS month, SUM(total_amount) AS total_amount, COUNT(*) AS order_count FROM purchase_orders WHERE submitted_at >= '2026-04-01' AND submitted_at < '2026-10-01' GROUP BY 1 ORDER BY 1 LIMIT 100", "SELECT po_number, status, total_amount, eta_date FROM purchase_orders WHERE status <> 'completed' AND (submitted_at IS NULL OR submitted_at < '2026-10-01') ORDER BY po_number LIMIT 100", "WITH inv AS (SELECT rf.sku, rf.product_id, SUM(rf.numeric_value) AS stock_on_hand, COUNT(*) AS fact_count FROM report_facts AS rf JOIN sales_reports AS sr ON sr.id = rf.report_id WHERE sr.status = 'confirmed' AND rf.status = 'confirmed' AND rf.metric_key = 'stock_on_hand' AND rf.period_end >= '2026-09-01' AND rf.period_end <= '2026-09-30' GROUP BY rf.sku, rf.product_id) SELECT inv.sku, p.product_name_en, p.product_name_native, inv.stock_on_hand, inv.fact_count FROM inv LEFT JOIN products AS p ON p.id = inv.product_id ORDER BY inv.sku LIMIT 100", "SELECT p.sku, p.product_name_en, SUM(rf.numeric_value) AS units_sold, COUNT(*) AS fact_count FROM report_facts AS rf JOIN sales_reports AS sr ON sr.id = rf.report_id LEFT JOIN products AS p ON p.id = rf.product_id WHERE rf.status = 'confirmed' AND sr.status = 'confirmed' AND rf.metric_key = 'units_sold' AND rf.period_start >= '2026-09-01' AND rf.period_end <= '2026-09-30' GROUP BY p.sku, p.product_name_en ORDER BY units_sold DESC LIMIT 100", "SELECT poi.product_name, poi.sku, SUM(poi.quantity) AS total_quantity, SUM(poi.line_total) AS total_amount, COUNT(*) AS line_count FROM purchase_orders AS po JOIN purchase_order_items AS poi ON poi.po_id = po.id WHERE po.submitted_at >= '2026-09-01' AND po.submitted_at < '2026-10-01' GROUP BY poi.product_name, poi.sku ORDER BY poi.product_name, poi.sku LIMIT 100"], "plan": [{"id": "report_draft", "agent": "report", "depends_on": []}, {"id": "chart_data", "agent": "data", "depends_on": []}], "charts": [{"legend": {"
eepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 818, "prompt_tokens": 1970, "completion_tokens": 32, "cache_hit_tokens": 1792, "cost_cny": 0.00034184000000000005, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 1481, "prompt_tokens": 3237, "completion_tokens": 112, "cache_hit_tokens": 3072, "cost_cny": 0.00067444, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 985, "prompt_tokens": 3735, "completion_tokens": 18, "cache_hit_tokens": 3584, "cost_cny": 0.00029468, "usage_source": "actual"}]}, "executed_sql": ["WITH po AS (SELECT id FROM purchase_orders WHERE submitted_at >= '2026-09-01' AND submitted_at < '2026-10-01'), agg AS (SELECT p.category, SUM(i.line_total) AS amount, SUM(i.quantity) AS cases FROM purchase_order_items AS i JOIN po ON i.po_id = po.id LEFT JOIN products AS p ON i.product_id = p.id GROUP BY p.category), tot AS (SELECT SUM(amount) AS total_amount FROM agg) SELECT a.category, a.amount, a.cases, t.total_amount, a.amount / t.total_amount AS ratio FROM agg AS a CROSS JOIN tot AS t ORDER BY a.amount DESC LIMIT 100", "SELECT poi.product_name, poi.sku, SUM(poi.quantity) AS total_quantity, SUM(poi.line_total) AS total_amount, COUNT(*) AS line_count FROM purchase_orders AS po JOIN purchase_order_items AS poi ON poi.po_id = po.id WHERE po.submitted_at >= '2026-09-01' AND po.submitted_at < '2026-10-01' GROUP BY poi.product_name, poi.sku ORDER BY poi.product_name, poi.sku LIMIT 100", "SELECT TO_CHAR(submitted_at, 'YYYY-MM') AS month, SUM(total_amount) AS total_amount, SUM(qty) AS total_quantity, COUNT(DISTINCT po_id) AS order_count FROM (SELECT po.id AS po_id, po.submitted_at, po.total_amount, COALESCE(i.qty, 0) AS qty FROM purchase_orders AS po LEFT JOIN (SELECT po_id, SUM(quantity) AS qty FROM purchase_order_items GROUP BY po_id) AS i ON i.po_id = po.id WHERE po.submitted_at >= '2026-04-01' AND po.submitted_at < '2026-10-01') AS t GROUP BY 1 ORDER BY 1 LIMIT 100", "WITH f AS (SELECT rf.sku, rf.product_id, rf.metric_key, SUM(rf.numeric_value) AS total FROM report_facts AS rf JOIN sales_reports AS sr ON sr.id = rf.report_id WHERE rf.status = 'confirmed' AND sr.status = 'confirmed' AND rf.period_start >= '2026-09-01' AND rf.period_end <= '2026-09-30' AND rf.metric_key IN ('stock_on_hand', 'units_sold') GROUP BY rf.sku, rf.product_id, rf.metric_key) SELECT COALESCE(p.sku, f.sku) AS sku, COALESCE(p.product_name_en, p.product_name_native) AS product_name, MAX(CASE WHEN f.metric_key = 'stock_on_hand' THEN f.total END) AS confirmed_stock_on_hand, MAX(CASE WHEN f.metric_key = 'units_sold' THEN f.total END) AS confirmed_units_sold FROM f LEFT JOIN products AS p ON p.id = f.product_id OR (f.product_id IS NULL AND p.sku = f.sku) GROUP BY COALESCE(p.sku, f.sku), COALESCE(p.product_name_en, p.product_name_native) ORDER BY sku LIMIT 100", "SELECT po_number, status, total_amount, eta_date FROM purchase_orders WHERE status <> 'completed' AND (submitted_at IS NULL OR submitted_at < '2026-10-01') ORDER BY po_number LIMIT 100", "SELECT i.product_name, i.sku, SUM(i.quantity) AS total_quantity, SUM(i.line_total) AS total_amount, COUNT(*) AS line_count FROM purchase_orders AS po JOIN purchase_order_items AS i ON i.po_id = po.id WHERE po.submitted_at >= '2026-09-01' AND po.submitted_at < '2026-10-01' GROUP BY i.product_name, i.sku ORDER BY total_amount DESC LIMIT 100"], "plan": [{"id": "1", "agent": "report", "depends_on": []}], "charts": [{"legend": {"bottom": "0", "textStyle": {"color": "#666"}}, "series": [{"data": [{"name": "Chocolate", "value": 10396.35, "itemStyle": {"color": "#4A6FA5"}}, {"name": "Biscuits & Cakes", "value": 8161.8, "itemStyle": {"color": "#9067A3"}}, {"name": "Grocery", "value": 1534.68, "itemStyle": {"color": "#48A18C"}}], "type": "pie", "label": {"show": true, "color":
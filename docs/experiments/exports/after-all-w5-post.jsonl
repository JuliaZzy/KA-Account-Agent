, "cache_hit_tokens": 1920, "cost_cny": 0.0036514, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 1043, "prompt_tokens": 6477, "completion_tokens": 22, "cache_hit_tokens": 1920, "cost_cny": 0.0046834, "usage_source": "actual"}]}, "executed_sql": ["WITH ac AS (SELECT id, title, exclusivity_type, annual_sales_target, annual_sales_target_currency, term_start_date, term_end_date FROM contracts WHERE status = 'active') SELECT ac.id AS contract_id, ac.title, ac.exclusivity_type, ac.annual_sales_target, ac.annual_sales_target_currency, ac.term_start_date, ac.term_end_date, cc.number, cc.title AS section_title, cc.path, cc.body FROM ac LEFT JOIN contract_chunks AS cc ON cc.contract_id = ac.id WHERE cc.body ILIKE '%目标%' OR cc.body ILIKE '%未达成%' OR cc.body ILIKE '%取消%' OR cc.body ILIKE '%终止%' OR cc.body ILIKE '%独家权%' OR cc.title ILIKE '%目标%' OR cc.title ILIKE '%独家%' OR cc.title ILIKE '%终止%' OR cc.title ILIKE '%期限%' ORDER BY cc.sibling_order LIMIT 100"], "plan": [{"id": "1", "agent": "data", "depends_on": []}], "po_count_before": 1349, "po_count_after": 1349, "order_created": false}
{"id": "con-qa-03", "category": "contract", "repeat": 2, "partnership_id": "ps-liancai-01", "user_id": "user-liancai-chen", "session_id": "457b1300e9404348ad255645b07bb66b", "run_id": "run_f663aeb2dbb5440bb6c99900410e6cf9", "seconds": 23.16, "answer": "根据《联采贸易-经销协议》第七条第7.3款，**未达到年度销售目标，不自动取消独家权**。\n\n具体条款内容如下：\n*   **未达标后果**：“未达到年度销售目标，不自动取消独家，也不改变第十条的折扣档。”\n*   **后续处理**：双方可以在续展通知期满前，书面商量是否调整下一年度目标。\n\n此外，合同第十五条规定，只有当一方严重违反本协议且收到书面通知后三十日内仍未改正时，守约方才可解除协议。单纯的销售目标未完成并不构成直接取消独家权的条件。", "ledger": {"run_status": "succeeded", "queue_wait_seconds": 0.060802, "server_seconds": 22.715391, "child_runs": [{"type": "data", "status": "succeeded"}, {"type": "open", "status": "queued"}], "model_calls": 6, "model_failures": 0, "model_seconds_sum": 12.22, "prompt_tokens": 21626, "completion_tokens": 771, "cost_cny": 0.012862, "unknown_usage_calls": 0, "calls": [{"run_type": "chat", "purpose": "orchestrator.plan", "provider": "qwen", "model": "qwen3.7-flash", "status": "succeeded", "latency_ms": 3239, "prompt_tokens": 2688, "completion_tokens": 109, "cache_hit_tokens": 2560, "cost_cny": 0.00021520000000000005, "usage_source": "actual"}, {"run_type": "chat", "purpose": "orchestrator.answer", "provider": "qwen", "model": "qwen3.7-flash", "status": "succeeded", "latency_ms": 3739, "prompt_tokens": 2509, "completion_tokens": 128, "cache_hit_tokens": 0, "cost_cny": 0.0006042, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 912, "prompt_tokens": 1964, "completion_tokens": 43, "cache_hit_tokens": 896, "cost_cny": 0.00125792, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "model": "deepseek-flash", "status": "succeeded", "latency_ms": 1723, "prompt_tokens": 3677, "completion_tokens": 218, "cache_hit_tokens": 1920, "cost_cny": 0.0026674, "usage_source": "actual"}, {"run_type": "data", "purpose": "data.react", "provider": "deepseek", "
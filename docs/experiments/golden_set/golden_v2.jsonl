{"id": "t2s-01", "category": "text2sql", "phase": "any", "tags": ["basic"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-04", "user_id": null}, "input": "2026年9月我们的采购总金额是多少？", "checks": [{"type": "numbers_present", "values": [11990.17], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"total": 11990.17}, "gold_sql": "SELECT ROUND(SUM(i.line_total),2) FROM purchase_orders o JOIN purchase_order_items i ON i.po_id=o.id JOIN products p ON p.id=i.product_id WHERE o.partnership_id='ps-liancai-04' AND substr(o.submitted_at,1,7)='2026-09'", "notes": ""}
{"id": "t2s-02", "category": "text2sql", "phase": "any", "tags": ["basic"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-01", "user_id": null}, "input": "2025年全年采购总金额？", "checks": [{"type": "numbers_present", "values": [77247.35], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"total": 77247.35}, "gold_sql": "SELECT ROUND(SUM(i.line_total),2) FROM purchase_orders o JOIN purchase_order_items i ON i.po_id=o.id JOIN products p ON p.id=i.product_id WHERE o.partnership_id='ps-liancai-01' AND substr(o.submitted_at,1,4)='2025'", "notes": ""}
{"id": "t2s-03", "category": "text2sql", "phase": "any", "tags": ["join-products", "group-by"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-15", "user_id": null}, "input": "2026年9月各品类的采购金额分别是多少？", "checks": [{"type": "numbers_present", "values": [23654.87, 1781.12, 517.94], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"rows": [["Breakfast", 23654.87], ["Chocolate", 1781.12], ["Beverages", 517.94]]}, "gold_sql": "SELECT p.category, ROUND(SUM(i.line_total),2) FROM purchase_orders o JOIN purchase_order_items i ON i.po_id=o.id JOIN products p ON p.id=i.product_id WHERE o.partnership_id='ps-liancai-15' AND substr(o.submitted_at,1,7)='2026-09' GROUP BY p.category ORDER BY 2 DESC", "notes": "品类在 products 上，必须 join；订单明细表没有 category。"}
{"id": "t2s-04", "category": "text2sql", "phase": "any", "tags": ["top-n"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-01", "user_id": null}, "input": "2025年采购金额最高的3个商品是什么？各多少钱？", "checks": [{"type": "numbers_present", "values": [17799.68, 15104.1, 14078.66], "hard": true}, {"type": "text_contains_all", "values": ["Activia bifidus saveur vanille sans arome artificiel 125 g x 12", "Activia bifidus nature 125g x 4", "Cerise"], "hard": false}, {"type": "read_only_sql", "hard": true}], "expected": {"rows": [["Activia bifidus saveur vanille sans arome artificiel 125 g x 12", 17799.68], ["Activia bifidus nature 125g x 4", 15104.1], ["Cerise", 14078.66]]}, "gold_sql": "SELECT p.product_name_en, ROUND(SUM(i.line_total),2) FROM purchase_orders o JOIN purchase_order_items i ON i.po_id=o.id JOIN products p ON p.id=i.product_id WHERE o.partnership_id='ps-liancai-01' AND substr(o.submitted_at,1,4)='2025' GROUP BY p.id ORDER BY 2 DESC LIMIT 3", "notes": ""}
{"id": "t2s-05", "category": "text2sql", "phase": "any", "tags": ["metric-key"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-01", "user_id": null}, "input": "2026年9月各渠道的销售额是多少？", "checks": [{"type": "numbers_present", "values": [1604.48, 1118.05, 769.4], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"rows": [["Tmall", 1604.48], ["JD", 1118.05], ["Offline", 769.4]]}, "gold_sql": "SELECT f.channel, ROUND(SUM(f.numeric_value),2) FROM report_facts f JOIN sales_reports r ON r.id=f.report_id WHERE r.partnership_id='ps-liancai-01' AND r.reporting_period='2026-09' AND f.status='confirmed' AND f.metric_key='revenue' GROUP BY f.channel ORDER BY 2 DESC", "notes": ""}
{"id": "t2s-06", "category": "text2sql", "phase": "any", "tags": ["metric-key", "trap"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-01", "user_id": null}, "input": "2026年9月的销售总额是多少？", "checks": [{"type": "numbers_present", "values": [3491.93], "hard": true}, {"type": "numbers_absent", "values": [4400.93], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"total_revenue": 3491.93, "wrong_if_no_metric_filter": 4400.93}, "gold_sql": "SELECT ROUND(SUM(f.numeric_value),2) FROM report_facts f JOIN sales_reports r ON r.id=f.report_id WHERE r.partnership_id='ps-liancai-01' AND r.reporting_period='2026-09' AND f.status='confirmed' AND f.metric_key='revenue'", "notes": "陷阱：report_facts 里 revenue / units_sold / stock_on_hand 混在 numeric_value 一列，不加 metric_key 过滤会把三者相加。"}
{"id": "t2s-07", "category": "text2sql", "phase": "any", "tags": ["metric-key"], "fixture": "seed_v2", "fixture_file": null, "scope": {"partnership_id": "ps-liancai-01", "user_id": null}, "input": "2026年9月各渠道卖了多少件？", "checks": [{"type": "numbers_present", "values": [326.0, 227.0, 156.0], "hard": true}, {"type": "read_only_sql", "hard": true}], "expected": {"rows": [["Tmall", 326.0], ["JD", 227.0], ["Offline", 156.0]]}, "gold_sql": "SELECT f.channel, ROUND(SUM(f.numeric_value),0) FROM report_facts f JOIN sales_reports r ON r.id=f.report_id WHERE r.partnership_id='ps-liancai-01' AND r.reporting_period='2026-09' AND f.status='confirmed' AND f.metric_key='units_sold' GROUP BY f.channel ORDER BY 2 DESC", "notes": ""}

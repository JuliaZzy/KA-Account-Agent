        <mxCell id="po-db1" value="orders …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=12;" vertex="1" parent="po-db"><mxGeometry x="1240" y="42" width="200" height="48" as="geometry"/></mxCell>
        <mxCell id="po-note" value="模型不算价、不判规则、不提交订单。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="400" height="40" as="geometry"/></mxCell>


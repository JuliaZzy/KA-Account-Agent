        <mxCell id="po-code" value="po/ 确定性代码" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="2100" height="180" as="geometry"/></mxCell>
        <mxCell id="po-confirm" value="确认门" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#f0fdf4;strokeColor=#4ade80;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="2100" height="120" as="geometry"/></mxCell>
        <mxCell id="po-db" value="PostgreSQL" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="2100" height="110" as="geometry"/></mxCell>

        <mxCell id="po-u1" value="下单意图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" vertex="1" parent="po-user"><mxGeometry x="80" y="48" width="140" height="48" as="geometry"/></mxCell>
        <mxCell id="po-l1" value="merge 到 slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="po-llm"><mxGeometry x="280" y="45" width="160" height="48" as="geometry"/></mxCell>
        <mxCell id="po-c1" value="SKU / 价格 / MOQ / 规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="po-code"><mxGeometry x="480" y="55" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="po-d1" value="通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;" vertex="1" parent="po-code"><mxGeometry x="720" y="50" width="100" height="65" as="geometry"/></mxCell>
        <mxCell id="po-missing" value="补 slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="po-code"><mxGeometry x="880" y="55" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="po-draft" value="草稿 + confirm token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="po-code"><mxGeometry x="1040" y="55" width="180" height="55" as="geometry"/></mxCell>

  <diagram id="po-flow" name="04 采购单确认与幂等">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="po-title" value="采购单：模型填槽位，代码定价，用户确认后提交" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="800" height="36" as="geometry"/></mxCell>
        <mxCell id="po-user" value="用户 / 聊天" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2100" height="110" as="geometry"/></mxCell>

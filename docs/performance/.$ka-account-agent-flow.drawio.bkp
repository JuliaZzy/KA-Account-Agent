    </mxGraphModel>
  </diagram>
  <diagram id="main-flow" name="02 主流程（泳道）">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KA Account Agent｜聊天请求（泳道简图）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="函数与事务细节见「00 运行时总览」与 docs/chat-flow.md。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="800" height="24" as="geometry"/></mxCell>

        <mxCell id="lane-user" value="用户 / 前端" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2900" height="110" as="geometry"/></mxCell>
        <mxCell id="lane-api" value="FastAPI" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#f0fdf4;strokeColor=#4ade80;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="2900" height="110" as="geometry"/></mxCell>
        <mxCell id="lane-queue" value="Outbox · Redis" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="2900" height="100" as="geometry"/></mxCell>
        <mxCell id="lane-worker" value="Celery worker" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#faf5ff;strokeColor=#c084fc;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="2900" height="130" as="geometry"/></mxCell>
        <mxCell id="lane-orch" value="编排" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#fdf2f8;strokeColor=#f472b6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="2900" height="130" as="geometry"/></mxCell>
        <mxCell id="lane-db" value="PostgreSQL" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="2900" height="120" as="geometry"/></mxCell>

        <mxCell id="u-send" value="① POST …/message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="lane-user"><mxGeometry x="60" y="45" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="u-poll" value="SSE 父 run + history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="lane-user"><mxGeometry x="2620" y="45" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="u-confirm" value="确认 / 停止（分支）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;dashed=1;" vertex="1" parent="lane-user"><mxGeometry x="1800" y="45" width="160" height="50" as="geometry"/></mxCell>

        <mxCell id="a-enqueue" value="② enqueue_chat_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="lane-api"><mxGeometry x="280" y="42" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="a-resume" value="resume / cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;dashed=1;" vertex="1" parent="lane-api"><mxGeometry x="1800" y="42" width="160" height="52" as="geometry"/></mxCell>

        <mxCell id="q-dispatch" value="③ dispatch · DB1 broker · DB0 波次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="lane-queue"><mxGeometry x="520" y="38" width="220" height="50" as="geometry"/></mxCell>

        <mxCell id="w-claim" value="④ claim → running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="lane-worker"><mxGeometry x="780" y="42" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="w-wait" value="waiting_for_user?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;dashed=1;" vertex="1" parent="lane-worker"><mxGeometry x="1800" y="35" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="w-done" value="complete_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="lane-worker"><mxGeometry x="2380" y="42" width="160" height="52" as="geometry"/></mxCell>

        <mxCell id="t-plan" value="⑤ PLAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-orch"><mxGeometry x="1000" y="42" width="140" height="52" as="geometry"/></mxCell>
        <mxCell id="t-wave" value="⑥ dispatch_wave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-orch"><mxGeometry x="1180" y="42" width="160" height="52" as="geometry"/></mxCell>
        <mxCell id="t-child" value="⑦ execute_task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-orch"><mxGeometry x="1380" y="42" width="160" height="52" as="geometry"/></mxCell>
        <mxCell id="t-ans" value="⑧ ANSWER · save_reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-orch"><mxGeometry x="2180" y="42" width="180" height="52" as="geometry"/></mxCell>

        <mxCell id="d-trace" value="run 轨迹 + chat_sessions.history（编排路径 ANSWER 后写 history）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=11;" vertex="1" parent="lane-db"><mxGeometry x="2180" y="40" width="360" height="55" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="u-send" target="a-enqueue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-enqueue" target="q-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="q-dispatch" target="w-claim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="w-claim" target="t-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-plan" target="t-wave"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-wave" target="t-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="波次齐" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="t-child" target="w-claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="720"/><mxPoint x="870" y="720"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-child" target="t-ans"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2100" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-ans" target="w-done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="w-done" target="d-trace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-trace" target="u-poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="实线 = 主路径；虚线 = 多波回 claim 或 waiting_for_user 分支。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="480" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

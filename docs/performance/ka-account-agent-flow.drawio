          <mxGeometry height="88" width="220" x="1020" y="50" as="geometry" />
        </mxCell>
        <mxCell id="rt-s6" parent="rt-l-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=11;" value="⑥ PLAN&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;execute_parent() · make_plan()&lt;/font&gt;&lt;br&gt;同一条父 run；多笔 PG&lt;br&gt;steps · model · checkpoint planned" vertex="1">
          <mxGeometry height="88" width="220" x="1260" y="50" as="geometry" />
        </mxCell>
        <mxCell id="rt-s7" parent="rt-l-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=11;" value="⑦ 派波&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;commit_task_wave()&lt;/font&gt;&lt;br&gt;PG：子 run×N + 父 tool.started&lt;br&gt;父 checkpoint · waiting_for_tasks&lt;br&gt;后：Redis begin_turn · dispatch 子" vertex="1">
          <mxGeometry height="104" width="240" x="1500" y="42" as="geometry" />
        </mxCell>
        <mxCell id="rt-s8" parent="rt-l-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=11;" value="⑧ 子 run&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;execute_task() · tool.fn()&lt;/font&gt;&lt;br&gt;多 worker 并行；不写 history&lt;br&gt;step/model 可投影到父 SSE" vertex="1">
          <mxGeometry height="88" width="220" x="1760" y="50" as="geometry" />

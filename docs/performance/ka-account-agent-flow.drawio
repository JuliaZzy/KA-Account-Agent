        </mxCell>
        <mxCell id="rt-empty" parent="rt-l-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;dashed=1;" value="tasks=[]&lt;br&gt;⑥ 直连 ⑩" vertex="1">

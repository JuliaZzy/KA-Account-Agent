        <mxCell id="rt-s2" parent="rt-l-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" value="② API&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;session_router.message()&lt;br&gt;enqueue_chat_run()&lt;/font&gt;&lt;br&gt;可选：chat_sessions.title + Redis 临时标题" vertex="1">

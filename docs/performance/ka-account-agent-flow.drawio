        </mxCell>
        <mxCell id="rt-l-notes" parent="rt-1" style="swimlane;html=1;horizontal=0;startSize=28;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;fontSize=13;" value="账本与回路" vertex="1">
          <mxGeometry height="200" width="3100" x="40" y="390" as="geometry" />
        </mxCell>
        <mxCell id="rt-tables" parent="rt-l-notes" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;align=left;" value="PostgreSQL 轨迹&lt;br&gt;agent_runs（状态）· run_events（时间线）· agent_steps（一步账本）&lt;br&gt;checkpoints · model_calls · tool_calls · usage_records · outbox_jobs · audit_logs&lt;br&gt;对话：chat_sessions.history（非独立表）· parent_run_id=重跑 · owner_run_id=调度父子" vertex="1">
          <mxGeometry height="90" width="720" x="60" y="45" as="geometry" />
        </mxCell>
        <mxCell id="rt-redis" parent="rt-l-notes" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;align=left;" value="Redis&lt;br&gt;DB0：会话锁、波次计数 begin_turn/store_result、临时标题&lt;br&gt;DB1：Celery broker · DB2：Celery 任务结果（非波次信箱）&lt;br&gt;计数归零不推 broker；最后子 run 里调 requeue + dispatch" vertex="1">
          <mxGeometry height="90" width="520" x="800" y="45" as="geometry" />
        </mxCell>
        <mxCell id="rt-loop" parent="rt-l-notes" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;align=left;" value="波次回路：⑦→⑧→⑨→⑤→⑥…→⑩。父 waiting_for_tasks 时释放租约。终态后可建 OPEN run（title 队列），不进聊天 SSE。" vertex="1">
          <mxGeometry height="55" width="600" x="1340" y="45" as="geometry" />
        </mxCell>
        <mxCell id="rt-open" parent="rt-l-notes" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;align=left;" value="首条消息只写临时 title；OPEN 精修在父 chat 终态之后（ka_account.title）。" vertex="1">
          <mxGeometry height="40" width="600" x="1340" y="110" as="geometry" />

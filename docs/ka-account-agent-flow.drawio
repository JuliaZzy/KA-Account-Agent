<mxfile host="app.diagrams.net" modified="2026-11-08T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="runtime-overview" name="00 运行时总览（推荐先看）">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="rt-0"/>
        <mxCell id="rt-1" parent="rt-0"/>
        <mxCell id="rt-title" value="KA Account Agent｜一次聊天 run 的完整运行时路径" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="rt-1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="rt-subtitle" value="先沿 ①→⑩ 看一轮；5–8 可能重复多次。每个 execute_run() 只处理一个 run 的一次投递，父 run 等子任务时会释放租约，子任务完成后再重新入队。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="rt-1"><mxGeometry x="32" y="60" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="rt-l-ui" value="用户 / Vite + React / FastAPI" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="110" width="2250" height="170" as="geometry"/></mxCell>
        <mxCell id="rt-l-db1" value="PostgreSQL：创建 run 的事务记录" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="280" width="2250" height="180" as="geometry"/></mxCell>
        <mxCell id="rt-l-q" value="Outbox + Redis + Celery broker" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="460" width="2250" height="180" as="geometry"/></mxCell>
        <mxCell id="rt-l-worker" value="Celery worker：领取并推进一个 run" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#faf5ff;strokeColor=#c084fc;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="640" width="2250" height="230" as="geometry"/></mxCell>
        <mxCell id="rt-l-orch" value="父 run 编排 / 子 run 执行" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fdf2f8;strokeColor=#f472b6;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="870" width="2250" height="240" as="geometry"/></mxCell>
        <mxCell id="rt-l-db2" value="PostgreSQL：轨迹、checkpoint、会话和业务结果" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f3f4f6;strokeColor=#4b5563;fontStyle=1;fontSize=14;" vertex="1" parent="rt-1"><mxGeometry x="30" y="1110" width="2250" height="240" as="geometry"/></mxCell>

        <mxCell id="rt-u1" value="① 用户发送消息&lt;br&gt;&lt;font style='font-size:11px'&gt;frontend/src/pages/Chat.tsx · send()&lt;br&gt;frontend/src/api.ts · streamMessage()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" vertex="1" parent="rt-l-ui"><mxGeometry x="70" y="55" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="rt-u2" value="② FastAPI 接收&lt;br&gt;&lt;font style='font-size:11px'&gt;router/session_router.py · message()&lt;br&gt;service.py · handle_message()&lt;br&gt;首次无标题会话另建 OPEN run → turn.execute_open()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="rt-l-ui"><mxGeometry x="390" y="45" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="rt-u3" value="⑪ 页面显示回复&lt;br&gt;&lt;font style='font-size:11px'&gt;followRun() 读 output_json.text&lt;br&gt;终态后读取 sessions.history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="rt-l-ui"><mxGeometry x="70" y="132" width="250" height="32" as="geometry"/></mxCell>
        <mxCell id="rt-db-create" value="③ 创建 queued run&lt;br&gt;&lt;font style='font-size:11px'&gt;services/chat_run.py · enqueue_chat_run()&lt;br&gt;repositories/run_repository.py · create_agent_run()&lt;/font&gt;&lt;br&gt;&lt;b&gt;写：agent_runs · run_events(run.created) · outbox_jobs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=12;" vertex="1" parent="rt-l-db1"><mxGeometry x="680" y="45" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="rt-q" value="④ 投递 execute_run&lt;br&gt;&lt;font style='font-size:11px'&gt;services/dispatcher.py · dispatch_pending()&lt;br&gt;outbox_jobs → Celery Redis broker（Redis DB 1）&lt;/font&gt;&lt;br&gt;&lt;b&gt;Redis DB 0：锁 / 限流；DB 2：任务结果&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="rt-l-q"><mxGeometry x="1020" y="40" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="rt-claim" value="⑤ worker 领取一次&lt;br&gt;&lt;font style='font-size:11px'&gt;celery/tasks.py · execute_run()&lt;br&gt;services/run_worker.py · work_once()&lt;br&gt;claim_chat_turn() / lease&lt;/font&gt;&lt;br&gt;&lt;b&gt;agent_runs：queued → running&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="rt-l-worker"><mxGeometry x="1360" y="40" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="rt-plan" value="⑥ 父 run 做 PLAN&lt;br&gt;&lt;font style='font-size:11px'&gt;services/chat_run.py · execute_chat()&lt;br&gt;orchestrator/parent.py · execute_parent()&lt;br&gt;orchestrator/plan.py · make_plan()&lt;/font&gt;&lt;br&gt;&lt;b&gt;写 agent_steps / model_calls / usage_records&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="rt-l-worker"><mxGeometry x="1700" y="40" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="rt-wave" value="⑦ 按波派子 run&lt;br&gt;&lt;font style='font-size:11px'&gt;orchestrator/gather.py · dispatch_wave()&lt;br&gt;_enqueue_child() · mark_waiting_for_tasks()&lt;/font&gt;&lt;br&gt;&lt;b&gt;父：waiting_for_tasks；owner_run_id 连接父子&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="rt-l-orch"><mxGeometry x="1700" y="45" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="rt-child" value="⑧ 子 run 执行任务&lt;br&gt;&lt;font style='font-size:11px'&gt;services/task_run.py · execute_task()&lt;br&gt;session_tools.py · tool.fn(...)&lt;br&gt;po / contract / report / data / brand / MCP&lt;/font&gt;&lt;br&gt;&lt;b&gt;写 tool_calls；结果写 child output_json&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="rt-l-orch"><mxGeometry x="2070" y="45" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="rt-requeue" value="⑨ 子任务完成，叫醒父 run&lt;br&gt;&lt;font style='font-size:11px'&gt;orchestrator/gather.py · finish_child()&lt;br&gt;append_checkpoint_result()&lt;br&gt;requeue_waiting_tasks() → dispatch_pending()&lt;/font&gt;&lt;br&gt;&lt;b&gt;Redis DB 2 wave mailbox 归零后重新投递父 run&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="rt-l-db2"><mxGeometry x="1700" y="45" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="rt-answer" value="⑩ 父 run ANSWER 并完成&lt;br&gt;&lt;font style='font-size:11px'&gt;orchestrator/parent.py · compose_answer()&lt;br&gt;orchestrator/speak.py · save_reply()&lt;br&gt;services/run_worker.py · complete_run()&lt;/font&gt;&lt;br&gt;&lt;b&gt;sessions.history；agent_runs → succeeded&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="rt-l-db2"><mxGeometry x="2070" y="45" width="190" height="110" as="geometry"/></mxCell>

        <mxCell id="rt-tables" value="轨迹账本（PostgreSQL）&lt;br&gt;agent_runs · agent_steps · run_events · checkpoints&lt;br&gt;model_calls · usage_records · tool_calls · audit_logs&lt;br&gt;outbox_jobs · dead_letter_jobs&lt;br&gt;&lt;br&gt;注意：第 ③ 步还没有 agent_steps；模型或工具真正开始时才写 step。&lt;br&gt;parent_run_id = rerun；owner_run_id = 调度父子关系。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;" vertex="1" parent="rt-l-db2"><mxGeometry x="70" y="55" width="470" height="125" as="geometry"/></mxCell>
        <mxCell id="rt-result" value="业务结果&lt;br&gt;采购：purchase_orders / purchase_order_items&lt;br&gt;合同：contracts / clauses / commercial_rules&lt;br&gt;报表：sales_reports / report_facts / narrative_reports&lt;br&gt;品牌资料：PostgreSQL 文档页 + Milvus 向量&lt;br&gt;页面通过 GET /runs/{id}、/trace、/events 读取。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;" vertex="1" parent="rt-l-db2"><mxGeometry x="610" y="55" width="700" height="125" as="geometry"/></mxCell>
        <mxCell id="rt-loop" value="波次回路：⑦ → ⑧ → ⑨ → ⑤/⑥；没有 tasks 时，⑥ 直接进入 ⑩。waiting_for_user 由用户确认后走 resume API，再重新投递 execute_run。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;" vertex="1" parent="rt-l-db2"><mxGeometry x="1370" y="175" width="850" height="45" as="geometry"/></mxCell>

        <mxCell id="rt-e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-u1" target="rt-u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e2" value="同一事务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-u2" target="rt-db-create"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e3" value="outbox 到期" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-db-create" target="rt-q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e4" value="Celery message(run_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-q" target="rt-claim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e5" value="chat parent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-claim" target="rt-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e6" value="tasks[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-plan" target="rt-wave"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e7" value="每个 task 一条 child run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-wave" target="rt-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e8" value="结果 / 计数归零" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-child" target="rt-requeue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e9" value="下一波或 ANSWER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="rt-1" source="rt-requeue" target="rt-answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rt-e10" value="再投递父 run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#c2410c;" edge="1" parent="rt-1" source="rt-requeue" target="rt-plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1860" y="760"/><mxPoint x="1860" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="rt-e11" value="输出读回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="rt-1" source="rt-answer" target="rt-u3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2170" y="1400"/><mxPoint x="90" y="1400"/><mxPoint x="90" y="1270"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="text-flow" name="01 文字流程（鉴权、重试、恢复）">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="txt-0"/>
        <mxCell id="txt-1" parent="txt-0"/>
        <mxCell id="txt-title" value="KA Account Agent｜文字流程：鉴权、幂等、重试、确认与清扫" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="txt-1"><mxGeometry x="30" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="txt-subtitle" value="这页补充“00 运行时总览”没有展开的控制流。先看蓝色正常路径，再看橙色重试、红色失败和紫色 sweeper。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="txt-1"><mxGeometry x="32" y="60" width="1300" height="30" as="geometry"/></mxCell>

        <mxCell id="txt-l-main" value="入口与正常执行路径" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;fontSize=14;" vertex="1" parent="txt-1"><mxGeometry x="30" y="110" width="2250" height="360" as="geometry"/></mxCell>
        <mxCell id="txt-l-retry" value="重试、幂等和人工控制" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;fontSize=14;" vertex="1" parent="txt-1"><mxGeometry x="30" y="470" width="2250" height="360" as="geometry"/></mxCell>
        <mxCell id="txt-l-sweep" value="sweeper 与可观测性" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#faf5ff;strokeColor=#c084fc;fontStyle=1;fontSize=14;" vertex="1" parent="txt-1"><mxGeometry x="30" y="830" width="2250" height="300" as="geometry"/></mxCell>
        <mxCell id="txt-l-state" value="状态与读模型" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f3f4f6;strokeColor=#4b5563;fontStyle=1;fontSize=14;" vertex="1" parent="txt-1"><mxGeometry x="30" y="1130" width="2250" height="220" as="geometry"/></mxCell>

        <mxCell id="txt-1a" value="① 鉴权 + 入口闸门&lt;br&gt;&lt;font style='font-size:11px'&gt;routes/runs.py · get_current_user()&lt;br&gt;X-User-Id → db.user() → org_id&lt;br&gt;entry_guard.admit_create() / admit_read()&lt;/font&gt;&lt;br&gt;&lt;b&gt;Redis 固定窗口限流和并发闸门&lt;/b&gt;&lt;br&gt;失败：401 UNAUTHENTICATED；429 RATE_LIMITED。聊天入口还校验 session。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="60" y="55" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="txt-2a" value="② 幂等创建 queued run&lt;br&gt;&lt;font style='font-size:11px'&gt;run_service.create_run() / chat_run.enqueue_chat_run()&lt;br&gt;find_run_by_idempotency_key()&lt;br&gt;create_agent_run()&lt;/font&gt;&lt;br&gt;&lt;b&gt;同一事务：agent_runs + run.created + outbox_jobs&lt;/b&gt;&lt;br&gt;同一个幂等键直接返回旧 run，不重复建任务。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="430" y="55" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="txt-3a" value="③ outbox → Celery broker&lt;br&gt;&lt;font style='font-size:11px'&gt;services/dispatcher.py · dispatch_pending()&lt;br&gt;outbox_jobs → Redis DB 1 → execute_run(run_id)&lt;/font&gt;&lt;br&gt;&lt;b&gt;两个事务：&lt;/b&gt;发消息和标记 dispatched 不在同一事务。&lt;br&gt;崩溃或投递丢失由 republish_unclaimed() 再投。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="800" y="55" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="txt-4a" value="④ worker claim + lease&lt;br&gt;&lt;font style='font-size:11px'&gt;celery/tasks.py · execute_run()&lt;br&gt;run_worker.work_once()&lt;br&gt;entry_guard.acquire_run() + claim_chat_turn()&lt;/font&gt;&lt;br&gt;状态：queued → running；租约写入 agent_runs。&lt;br&gt;SessionBusy → Celery 2 秒后重试；QUEUE_ENABLED 关闭 → 30 秒后重试。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="1170" y="55" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="txt-5a" value="⑤ PLAN / 按波派发&lt;br&gt;&lt;font style='font-size:11px'&gt;chat_run.execute_chat()&lt;br&gt;orchestrator.parent.execute_parent()&lt;br&gt;plan.make_plan() → gather.dispatch_wave()&lt;/font&gt;&lt;br&gt;写 agent_steps / model_calls / usage_records / checkpoints。父 run → waiting_for_tasks；owner_run_id 连接父子。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="1540" y="55" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="txt-6a" value="⑥ 子 run / 工具执行&lt;br&gt;&lt;font style='font-size:11px'&gt;task_run.execute_task()&lt;br&gt;session_tools.tools() → tool.fn()&lt;br&gt;run_loop.execute_tool()（工具内部）&lt;/font&gt;&lt;br&gt;先做开关、schema、权限、预算、幂等键检查，再 claim_tool_call()。成功或失败写 tool_calls、output_json、checkpoint。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="txt-l-main"><mxGeometry x="1910" y="55" width="330" height="145" as="geometry"/></mxCell>

        <mxCell id="txt-1b" value="⑦ 模型 / 上游重试&lt;br&gt;&lt;font style='font-size:11px'&gt;llm.calls.call_model() → ProviderError / ModelCapacityExceeded&lt;br&gt;run_worker._finish_claimed() → schedule_retry()&lt;/font&gt;&lt;br&gt;厂商 429/5xx/超时/断网：读 Retry-After 或 jitter；释放 model/run lease，spend_attempt=False。&lt;br&gt;401/403、400/422、坏响应、预算超限：不重试，直接失败或记录 model.failed。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="60" y="55" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="txt-2b" value="⑧ 工具校验、重试与副作用&lt;br&gt;&lt;font style='font-size:11px'&gt;run_loop._prepare_tool() / _finish_tool()&lt;br&gt;claim_tool_call() / complete_tool_call()&lt;/font&gt;&lt;br&gt;读工具错误最多再试 2 次（共 3 次）。副作用默认不自动重试。&lt;br&gt;业务键撞上 → skipped_duplicate；已交给外部系统但结果丢失 → response_lost + tool.manual_review。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="430" y="55" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="txt-3b" value="⑨ Run 级业务重试 / 死信&lt;br&gt;&lt;font style='font-size:11px'&gt;db/database/queue.py · schedule_retry()&lt;br&gt;run_worker._settle()&lt;/font&gt;&lt;br&gt;普通 Exception、模型解析失败等：1 分钟、5 分钟、15 分钟，最多 3 次。&lt;br&gt;耗尽：agent_runs → failed，outbox_jobs 停止，写 dead_letter_jobs。基础设施重试不增加业务次数。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="800" y="55" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="txt-4b" value="⑩ 用户确认、跳过、取消&lt;br&gt;&lt;font style='font-size:11px'&gt;db.mark_waiting_for_user()&lt;br&gt;routes/runs.py · resume_run() / cancel_run()&lt;br&gt;run_service.resume_run() / request_cancel()&lt;/font&gt;&lt;br&gt;确认/跳过：waiting_for_user → queued → dispatch。取消：worker 看到 cancel_requested_at 后 → cancelled。关页面只停止 SSE，不取消 run。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="1170" y="55" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="txt-5b" value="⑪ 父子波次恢复&lt;br&gt;&lt;font style='font-size:11px'&gt;gather.finish_child() → append_checkpoint_result()&lt;br&gt;requeue_waiting_tasks() → dispatch_pending()&lt;/font&gt;&lt;br&gt;Redis DB 2 计数归零后唤醒 owner。父 run 重新进入 queued，再由 execute_run() 继续下一波或 ANSWER。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="1540" y="55" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="txt-6b" value="⑫ 状态不是函数的返回值&lt;br&gt;&lt;font style='font-size:11px'&gt;repositories/run_repository.py → _transition()&lt;/font&gt;&lt;br&gt;queued → running → waiting_for_tasks → queued → succeeded。&lt;br&gt;也可能进入 waiting_for_user、failed、cancelled。状态、公开事件和 audit_logs 在同一事务提交。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="txt-l-retry"><mxGeometry x="1910" y="55" width="330" height="160" as="geometry"/></mxCell>

        <mxCell id="txt-s1" value="⑬ sweeper 每 15 秒一轮&lt;br&gt;&lt;font style='font-size:11px'&gt;services/sweeper.py · sweep()&lt;br&gt;sweep_expired_leases()&lt;br&gt;sweep_waiting_for_tasks()&lt;br&gt;sweep_attention() / republish_unclaimed() / dispatch_pending()&lt;/font&gt;&lt;br&gt;它不调模型、不执行工具，只释放过期租约、补投 outbox、唤醒已完成子任务，并记录 stale / reminder / manual review。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="txt-l-sweep"><mxGeometry x="60" y="55" width="430" height="155" as="geometry"/></mxCell>
        <mxCell id="txt-s2" value="⑭ 清扫判断&lt;br&gt;&lt;font style='font-size:11px'&gt;db/database/run.py&lt;/font&gt;&lt;br&gt;running 租约过期：取消请求则 cancelled，否则 queued 重投；执行次数耗尽则 failed。&lt;br&gt;waiting_for_tasks 超过 15 分钟且子女都终态：queued 重投；子女仍在跑则不动。&lt;br&gt;waiting_for_user 超过 1 天：只提醒，不替用户确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="txt-l-sweep"><mxGeometry x="540" y="55" width="430" height="155" as="geometry"/></mxCell>
        <mxCell id="txt-s3" value="⑮ 事件流与实时正文&lt;br&gt;&lt;font style='font-size:11px'&gt;routes/runs.py · events() / stream_run_events()&lt;br&gt;services/run_stream.py · iter_event_stream()&lt;br&gt;db.note_running_reply() → run.reply_updated&lt;/font&gt;&lt;br&gt;事件从 run_events 按 sequence 回放；Postgres NOTIFY 只负责唤醒。正文在 output_json.text，generation_id 变化时前端丢弃旧半截。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="txt-l-sweep"><mxGeometry x="1020" y="55" width="430" height="155" as="geometry"/></mxCell>
        <mxCell id="txt-s4" value="⑯ 监控和追踪&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /runs/{id}/trace · /events · /monitor · /metrics&lt;/font&gt;&lt;br&gt;读 agent_runs、agent_steps、model_calls、tool_calls、checkpoints、outbox、dead letters。会话 history 是用户看到的内容，run trace 是执行事实，两者分开保存。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="txt-l-sweep"><mxGeometry x="1500" y="55" width="430" height="155" as="geometry"/></mxCell>

        <mxCell id="txt-state" value="状态速查：queued → running → waiting_for_tasks → queued（子任务波次完成后）→ succeeded；工具要人时 running → waiting_for_user → queued；取消可从 queued / waiting_for_user / waiting_for_tasks 进入 cancelled；业务重试耗尽进入 failed；重跑是新建 run，parent_run_id 指向旧 run。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=13;" vertex="1" parent="txt-l-state"><mxGeometry x="60" y="55" width="1030" height="90" as="geometry"/></mxCell>
        <mxCell id="txt-rules" value="三条阅读原则&lt;br&gt;1. 鉴权和限流发生在 HTTP 入口，进不了 worker 的请求不会有 run。&lt;br&gt;2. 模型 / 工具已有业务结果后，优先重试该层；不要把副作用整段重跑。&lt;br&gt;3. Redis 是闸门、broker、wave mailbox；PostgreSQL 才是 run、checkpoint、工具和审计的账本。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;" vertex="1" parent="txt-l-state"><mxGeometry x="1150" y="55" width="1030" height="90" as="geometry"/></mxCell>

        <mxCell id="txt-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.4;" edge="1" parent="txt-1" source="txt-1a" target="txt-2a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.4;" edge="1" parent="txt-1" source="txt-2a" target="txt-3a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.4;" edge="1" parent="txt-1" source="txt-3a" target="txt-4a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.4;" edge="1" parent="txt-1" source="txt-4a" target="txt-5a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.4;" edge="1" parent="txt-1" source="txt-5a" target="txt-6a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e6" value="异常 / 控制流" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#c2410c;" edge="1" parent="txt-1" source="txt-6a" target="txt-1b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2070" y="430"/><mxPoint x="2250" y="430"/><mxPoint x="2250" y="550"/></Array></mxGeometry></mxCell>
        <mxCell id="txt-e7" value="控制流继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-1b" target="txt-2b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-2b" target="txt-3b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-3b" target="txt-4b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-4b" target="txt-5b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-5b" target="txt-6b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e12" value="系统周期任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7c3aed;" edge="1" parent="txt-1" source="txt-6b" target="txt-s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2080" y="820"/><mxPoint x="260" y="820"/><mxPoint x="260" y="890"/></Array></mxGeometry></mxCell>
        <mxCell id="txt-e13" value="清扫细节" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-s1" target="txt-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e14" value="事件 / trace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-s2" target="txt-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="txt-e15" value="读模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeWidth=1.2;" edge="1" parent="txt-1" source="txt-s3" target="txt-s4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="main-flow" name="02 主流程（泳道）">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KA Account Agent｜聊天请求到任务完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="业务分支图；运行时的函数、数据库、outbox、Celery 和 Redis 位置请先看“00 运行时总览”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="32" y="60" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="lane-user" value="用户 / 桌面（frontend）" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1900" height="170" as="geometry"/></mxCell>
        <mxCell id="lane-api" value="FastAPI API" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f0fdf4;strokeColor=#4ade80;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="1900" height="170" as="geometry"/></mxCell>
        <mxCell id="lane-queue" value="Outbox / Redis（DB 0 锁，DB 1 broker，DB 2 结果箱）" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="1900" height="150" as="geometry"/></mxCell>
        <mxCell id="lane-worker" value="Celery worker / run_worker（每条 execute_run 只推进一个 run）" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#faf5ff;strokeColor=#c084fc;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1900" height="210" as="geometry"/></mxCell>
        <mxCell id="lane-tools" value="模型与领域工具" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fdf2f8;strokeColor=#f472b6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1900" height="180" as="geometry"/></mxCell>
        <mxCell id="lane-db" value="PostgreSQL / Milvus" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="1900" height="180" as="geometry"/></mxCell>

        <mxCell id="u-send" value="① 发送聊天消息&lt;br&gt;&lt;font style='font-size:11px'&gt;POST /api/sessions/{id}/message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" vertex="1" parent="lane-user"><mxGeometry x="70" y="65" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="u-poll" value="⑩ 页面跟踪 run&lt;br&gt;&lt;font style='font-size:11px'&gt;frontend/src/api.ts · followRun()&lt;br&gt;GET /runs/{id}/trace + /events/stream&lt;/font&gt;&lt;br&gt;终态后重读 sessions.history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="lane-user"><mxGeometry x="1600" y="45" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="u-confirm" value="⑦ 用户确认 / 跳过&lt;br&gt;或点击停止&lt;br&gt;&lt;font style='font-size:11px'&gt;Chat.tsx · resumeApproval() / cancel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="lane-user"><mxGeometry x="1060" y="45" width="250" height="95" as="geometry"/></mxCell>

        <mxCell id="a-enqueue" value="② 创建 queued run&lt;br&gt;&lt;font style='font-size:11px'&gt;session_router.message() → service.handle_message()&lt;br&gt;chat_run.enqueue_chat_run() → create_agent_run()&lt;/font&gt;&lt;br&gt;写 agent_runs / run.created / outbox_jobs，立即返回 run_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="lane-api"><mxGeometry x="330" y="50" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="a-resume" value="⑧ resume / cancel API&lt;br&gt;&lt;font style='font-size:11px'&gt;routes/runs.py · resume_run() / cancel_run()&lt;br&gt;services/run_service.py · resume_run()&lt;/font&gt;&lt;br&gt;queued 后重新 dispatch_pending()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="lane-api"><mxGeometry x="1080" y="45" width="270" height="95" as="geometry"/></mxCell>

        <mxCell id="q-dispatch" value="③ dispatch_pending()&lt;br&gt;&lt;font style='font-size:11px'&gt;services/dispatcher.py&lt;br&gt;outbox_jobs → Celery broker（Redis DB 1）&lt;br&gt;DB 0 锁 / DB 2 结果箱&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="lane-queue"><mxGeometry x="610" y="35" width="280" height="85" as="geometry"/></mxCell>

        <mxCell id="w-claim" value="④ claim run&lt;br&gt;&lt;font style='font-size:11px'&gt;celery/tasks.py · execute_run()&lt;br&gt;run_worker.work_once() · claim_chat_turn()&lt;/font&gt;&lt;br&gt;queued → running，取得 lease" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="lane-worker"><mxGeometry x="880" y="35" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="w-decision" value="需要用户确认？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;" vertex="1" parent="lane-worker"><mxGeometry x="1160" y="30" width="150" height="95" as="geometry"/></mxCell>
        <mxCell id="w-execute" value="⑨ ANSWER / 完成&lt;br&gt;&lt;font style='font-size:11px'&gt;parent.compose_answer() → speak.save_reply()&lt;br&gt;run_worker.complete_run()&lt;/font&gt;&lt;br&gt;waiting_for_user 后由 resume API 重新投递" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12;" vertex="1" parent="lane-worker"><mxGeometry x="1390" y="35" width="280" height="85" as="geometry"/></mxCell>

        <mxCell id="t-react" value="⑤ 父 run PLAN&lt;br&gt;&lt;font style='font-size:11px'&gt;chat_run.execute_chat() → orchestrator.parent.execute_parent()&lt;br&gt;orchestrator.plan.make_plan() → tasks[]&lt;/font&gt;&lt;br&gt;写 agent_steps / model_calls / usage_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-tools"><mxGeometry x="880" y="40" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="t-domain" value="⑥ 子 run / 按波执行&lt;br&gt;&lt;font style='font-size:11px'&gt;gather.dispatch_wave() → _enqueue_child()&lt;br&gt;task_run.execute_task() → session_tools tool.fn(...)&lt;/font&gt;&lt;br&gt;po · contract · report · data · brand · tool / MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=12;" vertex="1" parent="lane-tools"><mxGeometry x="1180" y="35" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="t-error" value="异常：重试 → failed&lt;br&gt;耗尽后 dead letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="lane-tools"><mxGeometry x="1530" y="50" width="220" height="65" as="geometry"/></mxCell>

        <mxCell id="d-trace" value="PostgreSQL 账本&lt;br&gt;agent_runs · agent_steps · run_events · checkpoints&lt;br&gt;model_calls · usage_records · tool_calls · outbox_jobs&lt;br&gt;结果：sessions.history + 业务表；Redis 只做锁 / broker / wave mailbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=12;" vertex="1" parent="lane-db"><mxGeometry x="1320" y="35" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="d-vector" value="品牌文件向量&lt;br&gt;Milvus + PostgreSQL 文档页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="lane-db"><mxGeometry x="900" y="55" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="d-status" value="succeeded / waiting_for_user / cancelled / failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="lane-db"><mxGeometry x="1690" y="45" width="210" height="75" as="geometry"/></mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="u-send" target="a-enqueue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="a-enqueue" target="q-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="q-dispatch" target="w-claim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="w-claim" target="t-react"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="t-react" target="t-domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="轨迹 / 结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="t-domain" target="d-trace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="需要确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="t-domain" target="w-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="是：waiting_for_user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="w-decision" target="u-confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="确认 / 跳过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="u-confirm" target="a-resume"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="a-resume" target="w-execute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="否：继续循环" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="w-decision" target="w-execute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="w-execute" target="d-status"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="轮询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="d-status" target="u-poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#dc2626;" edge="1" parent="1" source="t-domain" target="t-error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.2;" edge="1" parent="1" source="t-domain" target="d-vector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="阅读顺序：先沿主路径从左到右；需要确认、取消和异常是从主路径分出的三类控制流。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="1210" width="600" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="domain-tools" name="03 领域工具路由">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="dt-title" value="领域工具路由：模型负责选择，领域代码负责执行" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="dt-note" value="这一页不画每个函数调用，只画工具边界和数据边界。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="32" y="65" width="700" height="25" as="geometry"/></mxCell>
        <mxCell id="dt-l1" value="聊天运行时" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#faf5ff;strokeColor=#c084fc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="2100" height="170" as="geometry"/></mxCell>
        <mxCell id="dt-l2" value="领域模块" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fdf2f8;strokeColor=#f472b6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="2100" height="250" as="geometry"/></mxCell>
        <mxCell id="dt-l3" value="外部工具与检索" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="2100" height="180" as="geometry"/></mxCell>
        <mxCell id="dt-l4" value="数据库与持久化" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="2100" height="180" as="geometry"/></mxCell>

        <mxCell id="dt-session" value="session_tools&lt;br&gt;统一工具入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=14;" vertex="1" parent="dt-l1"><mxGeometry x="100" y="60" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="dt-po" value="po.draft&lt;br&gt;采购草稿 / 售后索赔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="dt-l2"><mxGeometry x="400" y="55" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-contract" value="contract.read&lt;br&gt;合同抽取和待确认表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="dt-l2"><mxGeometry x="700" y="55" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-report" value="report.draft&lt;br&gt;查数、撰写、审核、图表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="dt-l2"><mxGeometry x="1000" y="55" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-query" value="data.query&lt;br&gt;只读 SELECT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="dt-l2"><mxGeometry x="1300" y="55" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-brand" value="brand.search&lt;br&gt;混合检索后回答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="dt-l2"><mxGeometry x="1600" y="55" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-tools" value="新闻 / 汇率 / 翻译 / 发信 / MCP&lt;br&gt;外部副作用按需确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="dt-l3"><mxGeometry x="920" y="55" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-po-db" value="orders / purchase_order_items&lt;br&gt;价格、MOQ、规则由代码决定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="dt-l4"><mxGeometry x="350" y="55" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-contract-db" value="contracts / extractions / clauses / rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="dt-l4"><mxGeometry x="700" y="55" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-report-db" value="sales_reports / report_facts / narrative_reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="dt-l4"><mxGeometry x="1080" y="55" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="dt-rag-db" value="brand_document_pages + Milvus vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="dt-l4"><mxGeometry x="1500" y="55" width="300" height="70" as="geometry"/></mxCell>

        <mxCell id="dt-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-po"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-contract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-brand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="dt-session" target="dt-tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e7" value="确认后提交" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.3;" edge="1" parent="1" source="dt-po" target="dt-po-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e8" value="确认后入库" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.3;" edge="1" parent="1" source="dt-contract" target="dt-contract-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e9" value="确认后保存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.3;" edge="1" parent="1" source="dt-report" target="dt-report-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e10" value="执行 SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.3;" edge="1" parent="1" source="dt-query" target="dt-report-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dt-e11" value="召回段落" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.3;" edge="1" parent="1" source="dt-brand" target="dt-rag-db"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="po-flow" name="04 采购单确认与幂等">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="po-title" value="采购单：模型填槽位，代码定价，用户确认后提交" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="po-user" value="用户 / 聊天" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#eff6ff;strokeColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2100" height="160" as="geometry"/></mxCell>
        <mxCell id="po-llm" value="LLM 抽取" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fdf2f8;strokeColor=#f472b6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="2100" height="160" as="geometry"/></mxCell>
        <mxCell id="po-code" value="确定性代码：po/check.py · rules.py · draft.py" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#fff7ed;strokeColor=#fb923c;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="2100" height="210" as="geometry"/></mxCell>
        <mxCell id="po-confirm" value="确认门" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f0fdf4;strokeColor=#4ade80;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="2100" height="170" as="geometry"/></mxCell>
        <mxCell id="po-db" value="PostgreSQL" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f9fafb;strokeColor=#9ca3af;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="2100" height="150" as="geometry"/></mxCell>

        <mxCell id="po-u1" value="“下单：产品 A，10 箱”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;" vertex="1" parent="po-user"><mxGeometry x="100" y="55" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="po-l1" value="把对话 merge 到固定 slot&lt;br&gt;产品、数量、折扣、收货信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=13;" vertex="1" parent="po-llm"><mxGeometry x="380" y="50" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="po-c1" value="1. 目录搜索 / SKU 对齐&lt;br&gt;2. 合同折扣预填&lt;br&gt;3. 代码计算箱价、MOQ、规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="po-code"><mxGeometry x="700" y="45" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="po-d1" value="校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;" vertex="1" parent="po-code"><mxGeometry x="1060" y="40" width="150" height="95" as="geometry"/></mxCell>
        <mxCell id="po-missing" value="缺项 / 规则不通过&lt;br&gt;回复用户，继续补 slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;" vertex="1" parent="po-code"><mxGeometry x="1280" y="50" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="po-draft" value="生成草稿 + confirm token&lt;br&gt;hash 绑定当前内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="po-code"><mxGeometry x="1580" y="50" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="po-u2" value="用户点击确认按钮&lt;br&gt;模型说“同意”不算确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;" vertex="1" parent="po-confirm"><mxGeometry x="1580" y="50" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="po-submit" value="先消费 token&lt;br&gt;再创建订单（幂等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" vertex="1" parent="po-confirm"><mxGeometry x="1880" y="50" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="po-db1" value="orders + purchase_order_items&lt;br&gt;后续收货 / 付款 / 索赔更新订单状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontSize=13;" vertex="1" parent="po-db"><mxGeometry x="1720" y="45" width="330" height="70" as="geometry"/></mxCell>

        <mxCell id="po-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-u1" target="po-l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-l1" target="po-c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-c1" target="po-d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#dc2626;" edge="1" parent="1" source="po-d1" target="po-missing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-d1" target="po-draft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-draft" target="po-u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-u2" target="po-submit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="po-submit" target="po-db1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-e9" value="继续补充" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#dc2626;" edge="1" parent="1" source="po-missing" target="po-u1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="po-note" value="这页最重要的设计约束：模型不算价、不判规则、不提交订单；它只把对话填入固定 slot。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="720" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

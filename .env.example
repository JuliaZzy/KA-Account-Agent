# ── LLM 配置 ────────────────────────────
# ── 选项 A：上海交大校园 API ──
# 调用名：deepseek-chat（通用）| deepseek-reasoner（深度思考，偏慢）| minimax | qwen（识图）
SJTU_BASE_URL=https://models.sjtu.edu.cn/api/v1
SJTU_API_KEY=

# ── 选项 B：OpenAI ──────────────────────────────
# LLM_API_KEY=sk-在这里填你的key
# LLM_MODEL=gpt-4.1

# ── 选项 C：DeepSeek ──
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ── 选项 D：智谱 GLM ────────────────────────────
GLM_BASE_URL=https://open.bigmodel.cn/api/v1/responses
GLM_API_KEY=

# ── 选项 E：Qwen（官方；PLAN 用 qwen3.7-flash，不是校园识图 qwen）────────────────────────────
QWEN_BASE_URL=https://llm-hzjcp5cfyjka8yps.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=


# ── RAG 配置 ────────────────────────────
# ── Embedding ────────────────────────────
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ── Rerank ────────────────────────────
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 数据库、Redis、Milvus 的地址由 Docker Compose 注入，不要写在这里。
# 连接池默认 10 / 20 / 30，需要时再设 KA_ACCOUNT_POOL_SIZE、KA_ACCOUNT_MAX_OVERFLOW、KA_ACCOUNT_POOL_TIMEOUT。

# 工具调用API
BOCHA_API_KEY=
SOCIALCRAWL_API_KEY=

# --- Email (send_email / QQ SMTP) ---
# QQ mailbox: 设置 → 账户 → 开启 SMTP，生成「授权码」填到 SMTP_PASSWORD（不是QQ登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
EMAIL_DRY_RUN=0

